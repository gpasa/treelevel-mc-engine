<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CalcHEP compile le code d'un processus chez l'utilisateur, puis le charge : la bibliothèque produite
	     ne porte évidemment pas notre signature. Sans cette dérogation, le hardened runtime la refuse. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
